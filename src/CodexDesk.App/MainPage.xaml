<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:CodexDesk.Components"
             x:Class="CodexDesk.MainPage"
             BackgroundColor="Transparent">

    <Grid x:Name="MainLayoutGrid"
          Padding="0"
          RowDefinitions="*">
        <Border Margin="-80,-30,0,0"
                WidthRequest="320"
                HeightRequest="320"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                BackgroundColor="#2E4E95AD"
                StrokeThickness="0"
                StrokeShape="Ellipse" />

        <Border Margin="0,-20,-70,0"
                WidthRequest="260"
                HeightRequest="260"
                HorizontalOptions="End"
                VerticalOptions="Start"
                BackgroundColor="#26C38E5F"
                StrokeThickness="0"
                StrokeShape="Ellipse" />

        <Border x:Name="ChatPane"
                BackgroundColor="#89FFFAF4"
                Stroke="#1C14232B"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 30">
            <Border.Shadow>
                <Shadow Brush="#1A101D23"
                        Offset="0,18"
                        Radius="34"
                        Opacity="1" />
            </Border.Shadow>

            <Grid RowDefinitions="72,*"
                  RowSpacing="0">
                <Border Grid.Row="0"
                        BackgroundColor="#E8F1EFEB"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 30,30,0,0">
                    <Grid Padding="12,12,148,0"
                          ColumnDefinitions="Auto,Auto,Auto,*"
                          ColumnSpacing="6">
                        <Border Grid.Column="0"
                                x:Name="CodexTabBorder"
                                ClassId="Codex"
                                BackgroundColor="#F7FFFCF8"
                                Stroke="#12000000"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18,18,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWorkspaceTabClicked" />
                            </Border.GestureRecognizers>
                            <Grid Padding="16,0"
                                  ColumnDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  HeightRequest="54">
                                <Border x:Name="CodexTabIcon"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        BackgroundColor="#1220252C"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="C"
                                           FontFamily="Bahnschrift"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#14232B"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                       x:Name="CodexTabTitleLabel"
                                       Text="Codex"
                                       FontFamily="Bahnschrift"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#14232B"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="2"
                                       x:Name="CodexTabCountLabel"
                                       Text="default"
                                       FontFamily="Bahnschrift"
                                       FontSize="12"
                                       TextColor="#61757E"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                x:Name="WebBrowserTabBorder"
                                ClassId="WebBrowser"
                                BackgroundColor="#1120252C"
                                Stroke="#10000000"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18,18,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWorkspaceTabClicked" />
                            </Border.GestureRecognizers>
                            <Grid Padding="16,0"
                                  ColumnDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  HeightRequest="54">
                                <Border x:Name="WebBrowserTabIcon"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        BackgroundColor="#1220252C"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="W"
                                           FontFamily="Bahnschrift"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#637780"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                       x:Name="WebBrowserTabTitleLabel"
                                       Text="WebBrowser"
                                       FontFamily="Bahnschrift"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#637780"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="2"
                                       x:Name="WebBrowserTabCountLabel"
                                       Text="tab"
                                       FontFamily="Bahnschrift"
                                       FontSize="12"
                                       TextColor="#61757E"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                x:Name="NetworkCaptureTabBorder"
                                ClassId="NetworkCapture"
                                BackgroundColor="#1120252C"
                                Stroke="#10000000"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18,18,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWorkspaceTabClicked" />
                            </Border.GestureRecognizers>
                            <Grid Padding="16,0"
                                  ColumnDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  HeightRequest="54">
                                <Border x:Name="NetworkCaptureTabIcon"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        BackgroundColor="#1220252C"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="N"
                                           FontFamily="Bahnschrift"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#637780"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                       x:Name="NetworkCaptureTabTitleLabel"
                                       Text="Network Capture"
                                       FontFamily="Bahnschrift"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#637780"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="2"
                                       x:Name="NetworkCaptureTabCountLabel"
                                       Text="tab"
                                       FontFamily="Bahnschrift"
                                       FontSize="12"
                                       TextColor="#61757E"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <ContentView Grid.Column="3"
                                     x:Name="WindowDragRegion"
                                     HeightRequest="54"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Start"
                                     BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Padding="0"
                      RowSpacing="0">
                    <Grid x:Name="CodexWorkspacePanel"
                          IsVisible="True"
                          RowDefinitions="*">
                        <Border x:Name="CodexPane"
                                BackgroundColor="#B3FFFFFF"
                                Stroke="#16142324"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24">
                            <BlazorWebView x:Name="blazorWebView"
                                           HostPage="wwwroot/index.html">
                                <BlazorWebView.RootComponents>
                                    <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
                                </BlazorWebView.RootComponents>
                            </BlazorWebView>
                        </Border>
                    </Grid>

                    <Grid x:Name="WebBrowserWorkspacePanel"
                          IsVisible="False"
                          RowDefinitions="Auto,*,Auto"
                          RowSpacing="0">
                        <Border Margin="12,0,12,12"
                                Padding="10"
                                BackgroundColor="#ADFFFFFF"
                                Stroke="#14142324"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 0,0,22,22">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10">
                                <HorizontalStackLayout Spacing="8">
                                    <Border WidthRequest="38"
                                            HeightRequest="38"
                                            BackgroundColor="#1220252C"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12">
                                        <Button x:Name="BrowserBackButton"
                                                Text="&#x2190;"
                                                FontSize="14"
                                                BackgroundColor="Transparent"
                                                TextColor="#50656F"
                                                Padding="0"
                                                Clicked="OnBrowserBackClicked" />
                                    </Border>
                                    <Border WidthRequest="38"
                                            HeightRequest="38"
                                            BackgroundColor="#1220252C"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12">
                                        <Button x:Name="BrowserForwardButton"
                                                Text="&#x2192;"
                                                FontSize="14"
                                                BackgroundColor="Transparent"
                                                TextColor="#50656F"
                                                Padding="0"
                                                Clicked="OnBrowserForwardClicked" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Border Grid.Column="1"
                                        HeightRequest="42"
                                        BackgroundColor="#D1FFFFFF"
                                        Stroke="#1420252C"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10"
                                          Padding="14,0,6,0">
                                        <Border WidthRequest="22"
                                                HeightRequest="22"
                                                VerticalOptions="Center"
                                                BackgroundColor="#1F67801F"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 11">
                                            <Label Text="•"
                                                   FontSize="11"
                                                   TextColor="#1F6780"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                        </Border>
                                        <Entry Grid.Column="1"
                                               x:Name="BrowserAddressEntry"
                                               Placeholder="https://www.google.com/"
                                               FontFamily="Bahnschrift"
                                               FontSize="14"
                                               TextColor="#536972"
                                               PlaceholderColor="#6B8793"
                                               ClearButtonVisibility="WhileEditing"
                                               ReturnType="Go"
                                               Completed="OnBrowserAddressEntryCompleted"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="2"
                                                x:Name="BrowserGoButton"
                                                Text="Open"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="14,0"
                                                HeightRequest="32"
                                                CornerRadius="999"
                                                BackgroundColor="#1F6780"
                                                TextColor="#FFFFFF"
                                                Clicked="OnBrowserAddressGoClicked"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <HorizontalStackLayout Grid.Column="2"
                                                       Spacing="8">
                                    <Button x:Name="WebViewNetworkCaptureToggleButton"
                                            Text="Capture OFF"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1220252C"
                                            TextColor="#50656F"
                                            Clicked="OnWebViewNetworkCaptureToggleClicked" />
                                    <Button x:Name="BrowserFocusButton"
                                            Text="Focus"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1220252C"
                                            TextColor="#50656F"
                                            Clicked="OnBrowserFocusClicked" />
                                    <Button x:Name="WebViewInspectorToggleButton"
                                            Text="Inspect OFF"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1220252C"
                                            TextColor="#50656F"
                                            Clicked="OnWebViewInspectorToggleClicked" />
                                    <Button x:Name="BrowserCookieButton"
                                            Text="Cookie"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1220252C"
                                            TextColor="#50656F"
                                            Clicked="OnBrowserCookieClicked" />
                                    <Button x:Name="BrowserRequestButton"
                                            Text="Request"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1F6780"
                                            TextColor="#FFFFFF"
                                            Clicked="OnBrowserRequestClicked" />
                                    <Button x:Name="BrowserSnapshotButton"
                                            Text="Snapshot"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1220252C"
                                            TextColor="#50656F"
                                            Clicked="OnBrowserSnapshotClicked" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                x:Name="BrowserPane"
                                Margin="12,0,12,0"
                                BackgroundColor="#96FFFFFF"
                                Stroke="#14142324"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24">
                            <Grid>
                                <Border Margin="0"
                                        BackgroundColor="#BFFFFFFF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 24">
                                    <Grid>
                                        <WebView x:Name="NaverTalkWebView"
                                                 Navigating="OnNaverTalkNavigating"
                                                 Navigated="OnNaverTalkNavigated"
                                                 Focused="OnNaverTalkWebViewFocused"
                                                 Unfocused="OnNaverTalkWebViewUnfocused" />
                                        <Grid IsVisible="False"
                                              HeightRequest="0">
                                            <Label x:Name="BrowserStatusLabel"
                                                   Text="WebView is idle." />
                                            <Label x:Name="BrowserUrlLabel"
                                                   Text="about:blank" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="12,12,12,12"
                                Padding="14,10"
                                BackgroundColor="#8FFFFFFF"
                                Stroke="#14142324"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="Viewport synced"
                                       FontFamily="Bahnschrift"
                                       FontSize="13"
                                       TextColor="#50656F" />
                                <Label Text="Desktop view"
                                       FontFamily="Bahnschrift"
                                       FontSize="13"
                                       TextColor="#50656F" />
                                <Label Text="Live navigation"
                                       FontFamily="Bahnschrift"
                                       FontSize="13"
                                       TextColor="#50656F" />
                            </HorizontalStackLayout>
                        </Border>

                        <Grid x:Name="InspectDetailsModal"
                              Grid.RowSpan="3"
                              IsVisible="False"
                              BackgroundColor="#660E171B"
                              Padding="36">
                            <Border BackgroundColor="#F4FBFCFC"
                                    Stroke="#1A18252C"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    MaximumWidthRequest="820"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Grid RowDefinitions="Auto,Auto,*"
                                      RowSpacing="0">
                                    <Grid Padding="18,16"
                                          ColumnDefinitions="*,Auto"
                                          BackgroundColor="#F8FFFFFF">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Inspect Details"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="#18252C" />
                                            <Label x:Name="InspectModalSelectorLabel"
                                                   Text="선택된 요소 없음"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextColor="#637780"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="Close"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="14,9"
                                                CornerRadius="12"
                                                BackgroundColor="#1220252C"
                                                TextColor="#50656F"
                                                Clicked="OnCloseInspectorModalClicked" />
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Padding="18,0,18,14"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="8"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="8"
                                          BackgroundColor="#F8FFFFFF">
                                        <Border BackgroundColor="#1220252C" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,9">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="TAG / TYPE" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" />
                                                <Label x:Name="InspectModalTagLabel" Text="-" FontFamily="Consolas" FontSize="13" TextColor="#18252C" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Column="1" BackgroundColor="#1220252C" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,9">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="POSITION" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" />
                                                <Label x:Name="InspectModalRectLabel" Text="-" FontFamily="Consolas" FontSize="13" TextColor="#18252C" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="1" BackgroundColor="#1220252C" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,9">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="IDENTITY" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" />
                                                <Label x:Name="InspectModalIdentityLabel" Text="-" FontFamily="Consolas" FontSize="13" TextColor="#18252C" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#1220252C" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,9">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="LINK / ROLE" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" />
                                                <Label x:Name="InspectModalMetaLabel" Text="-" FontFamily="Consolas" FontSize="13" TextColor="#18252C" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>

                                    <ScrollView Grid.Row="2"
                                                Orientation="Vertical">
                                        <VerticalStackLayout Spacing="12"
                                                             Padding="18,16,18,18">
                                            <Label Text="Preview"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="12"
                                                   TextColor="#667882" />
                                            <Border BackgroundColor="#EFFFFFFF"
                                                    Stroke="#12142324"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 14"
                                                    Padding="12">
                                                <Label x:Name="InspectModalPreviewLabel"
                                                       Text="-"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextColor="#30464F"
                                                       LineBreakMode="WordWrap" />
                                            </Border>

                                            <Label Text="DOM Path"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="12"
                                                   TextColor="#667882" />
                                            <Border BackgroundColor="#EFFFFFFF"
                                                    Stroke="#12142324"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 14"
                                                    Padding="12">
                                                <Label x:Name="InspectModalDomPathLabel"
                                                       Text="-"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextColor="#30464F"
                                                       LineBreakMode="WordWrap" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </ScrollView>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="CookieImportModal"
                              Grid.RowSpan="3"
                              IsVisible="False"
                              BackgroundColor="#660E171B"
                              Padding="36">
                            <Border BackgroundColor="#F4FBFCFC"
                                    Stroke="#1A18252C"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    MaximumWidthRequest="900"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Grid RowDefinitions="Auto,Auto,*,Auto"
                                      RowSpacing="12"
                                      Padding="18">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Cookie Import"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="#18252C" />
                                            <Label Text="브라우저 Cookie 헤더를 붙여넣으면 현재 WebBrowser 세션에만 주입합니다. 코드에는 저장하지 않습니다."
                                                   FontFamily="Bahnschrift"
                                                   FontSize="12"
                                                   TextColor="#637780" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="Close"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="14,9"
                                                CornerRadius="12"
                                                BackgroundColor="#1220252C"
                                                TextColor="#50656F"
                                                Clicked="OnCloseCookieImportModalClicked" />
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="*,Auto,Auto,Auto"
                                          ColumnSpacing="10">
                                        <Border BackgroundColor="#DFFFFFFF"
                                                Stroke="#1420252C"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 14"
                                                HeightRequest="44">
                                            <Entry x:Name="CookieDomainEntry"
                                                   Margin="12,0"
                                                   Placeholder="쿠키를 넣을 도메인 예: https://www.aliexpress.com 또는 aliexpress.com"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="13"
                                                   TextColor="#31474F"
                                                   PlaceholderColor="#6B8793"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Button Grid.Column="1"
                                                x:Name="ApplyCookieButton"
                                                Text="Apply Cookies"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="16,9"
                                                CornerRadius="12"
                                                BackgroundColor="#1F6780"
                                                TextColor="#FFFFFF"
                                                Clicked="OnApplyCookieClicked" />
                                        <Button Grid.Column="2"
                                                x:Name="GetCurrentCookiesButton"
                                                Text="Get Current"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="16,9"
                                                CornerRadius="12"
                                                BackgroundColor="#EEF3F6"
                                                TextColor="#31474F"
                                                Clicked="OnGetCurrentCookiesClicked" />
                                        <Button Grid.Column="3"
                                                x:Name="CopyCookiesButton"
                                                Text="Copy"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="16,9"
                                                CornerRadius="12"
                                                BackgroundColor="#EEF3F6"
                                                TextColor="#31474F"
                                                Clicked="OnCopyCookiesClicked" />
                                    </Grid>

                                    <Border Grid.Row="2"
                                            BackgroundColor="#DFFFFFFF"
                                            Stroke="#1420252C"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            MinimumHeightRequest="260">
                                        <Editor x:Name="CookieHeaderEditor"
                                                Margin="12"
                                                Placeholder="cna=...; _tb_token_=...; JSESSIONID=..."
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                TextColor="#14313A"
                                                PlaceholderColor="#7A8F98"
                                                AutoSize="TextChanges" />
                                    </Border>

                                    <Label Grid.Row="3"
                                           x:Name="CookieImportStatusLabel"
                                           Text="쿠키는 민감정보입니다. 필요한 사이트에서만 사용하고 공유/커밋하지 마세요."
                                           FontFamily="Bahnschrift"
                                           FontSize="12"
                                           TextColor="#B35A4A" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="BrowserRequestModal"
                              Grid.RowSpan="3"
                              IsVisible="False"
                              BackgroundColor="#660E171B"
                              Padding="36">
                            <Border BackgroundColor="#F4FBFCFC"
                                    Stroke="#1A18252C"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    MaximumWidthRequest="920"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
                                      RowSpacing="12"
                                      Padding="18">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="WebView Request"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="#18252C" />
                                            <Label Text="현재 WebView 로그인 세션으로 fetch를 실행합니다. 쿠키와 브라우저 헤더는 WebView가 처리합니다."
                                                   FontFamily="Bahnschrift"
                                                   FontSize="12"
                                                   TextColor="#637780" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="Close"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="14,9"
                                                CornerRadius="12"
                                                BackgroundColor="#1220252C"
                                                TextColor="#50656F"
                                                Clicked="OnCloseBrowserRequestModalClicked" />
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="120,*,Auto"
                                          ColumnSpacing="10">
                                        <Border BackgroundColor="#DFFFFFFF"
                                                Stroke="#1420252C"
                                                StrokeThickness="1"

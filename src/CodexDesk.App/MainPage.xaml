<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:CodexDesk.Components"
             xmlns:layout="clr-namespace:CodexDesk.Components.Layout"
             x:Class="CodexDesk.MainPage"
             BackgroundColor="Transparent">

    <Grid x:Name="MainLayoutGrid"
          Padding="0"
          ColumnDefinitions="248,*"
          RowDefinitions="64,*">
        <Border Margin="-80,-30,0,0"
                WidthRequest="320"
                HeightRequest="320"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                BackgroundColor="#2E4E95AD"
                StrokeThickness="0"
                StrokeShape="Ellipse" />

        <Border Margin="0,-20,-70,0"
                WidthRequest="260"
                HeightRequest="260"
                HorizontalOptions="End"
                VerticalOptions="Start"
                BackgroundColor="#26C38E5F"
                StrokeThickness="0"
                StrokeShape="Ellipse" />

        <BlazorWebView x:Name="sidebarBlazorWebView"
                       Grid.Column="0"
                       Grid.RowSpan="2"
                       HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type layout:Sidebar}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <BlazorWebView x:Name="headerBlazorWebView"
                       Grid.Column="1"
                       Grid.Row="0"
                       HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type layout:WorkspaceHeader}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <Border Grid.Column="0"
                IsVisible="False"
                BackgroundColor="#F7FFFCF8"
                Stroke="#1820252C"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24">
            <Grid Padding="14"
                  RowDefinitions="Auto,Auto,*,Auto"
                  RowSpacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="CODEX DESK"
                           FontFamily="Bahnschrift"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="#1F6780" />
                    <Label Text="Workspace"
                           FontFamily="Bahnschrift"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#14232B" />
                    <Label Text="Browser tools for focused work"
                           FontSize="12"
                           TextColor="#6A7F88" />
                </VerticalStackLayout>

                <Border Grid.Row="1"
                        Padding="12,10"
                        BackgroundColor="#EAF4F0"
                        Stroke="#1A1F6780"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="10">
                        <Border WidthRequest="28"
                                HeightRequest="28"
                                BackgroundColor="#1F6780"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 9">
                            <Label Text="CD"
                                   FontFamily="Bahnschrift"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="Default workspace"
                                   FontFamily="Bahnschrift"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#14232B" />
                            <Label Text="Local session"
                                   FontSize="11"
                                   TextColor="#6A7F88" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Grid.Row="2" Spacing="6">
                    <Label Text="WORKSPACE"
                           Margin="8,0,0,4"
                           FontFamily="Bahnschrift"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="1.2"
                           TextColor="#70838B" />

                    <Border x:Name="CodexNavigationBorder"
                            ClassId="Codex"
                            Padding="12,10"
                            BackgroundColor="#1F6780"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWorkspaceTabClicked" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border x:Name="CodexNavigationIcon"
                                    WidthRequest="26"
                                    HeightRequest="26"
                                    BackgroundColor="#33FFFFFF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Label Text="C"
                                       FontFamily="Bahnschrift"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   x:Name="CodexNavigationTitleLabel"
                                   Text="Codex chat"
                                   FontFamily="Bahnschrift"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   x:Name="CodexNavigationCountLabel"
                                   Text="default"
                                   FontSize="11"
                                   TextColor="#D6F2E7"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="WebBrowserNavigationBorder"
                            ClassId="WebBrowser"
                            Padding="12,10"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWorkspaceTabClicked" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border x:Name="WebBrowserNavigationIcon"
                                    WidthRequest="26"
                                    HeightRequest="26"
                                    BackgroundColor="#1420252C"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Label Text="W"
                                       FontFamily="Bahnschrift"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#516A74"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   x:Name="WebBrowserNavigationTitleLabel"
                                   Text="Web browser"
                                   FontFamily="Bahnschrift"
                                   FontSize="14"
                                   TextColor="#516A74"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   x:Name="WebBrowserNavigationCountLabel"
                                   Text="0"
                                   FontSize="11"
                                   TextColor="#70838B"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="NetworkCaptureNavigationBorder"
                            ClassId="NetworkCapture"
                            Padding="12,10"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWorkspaceTabClicked" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border x:Name="NetworkCaptureNavigationIcon"
                                    WidthRequest="26"
                                    HeightRequest="26"
                                    BackgroundColor="#1420252C"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Label Text="N"
                                       FontFamily="Bahnschrift"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#516A74"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   x:Name="NetworkCaptureNavigationTitleLabel"
                                   Text="Network captures"
                                   FontFamily="Bahnschrift"
                                   FontSize="14"
                                   TextColor="#516A74"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   x:Name="NetworkCaptureNavigationCountLabel"
                                   Text="0"
                                   FontSize="11"
                                   TextColor="#70838B"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>

                    <BoxView HeightRequest="1" Margin="6,10" Color="#1420252C" />

                    <Border Padding="12,10" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border WidthRequest="26" HeightRequest="26" BackgroundColor="#1420252C" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                <Label Text="P" FontFamily="Bahnschrift" FontSize="12" TextColor="#516A74" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Prompt library" FontFamily="Bahnschrift" FontSize="14" TextColor="#7A8D95" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border Grid.Row="3"
                        Padding="12,10"
                        BackgroundColor="#F0F5F3"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border WidthRequest="26" HeightRequest="26" BackgroundColor="#1420252C" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <Label Text="?" FontFamily="Bahnschrift" FontSize="13" FontAttributes="Bold" TextColor="#516A74" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="Settings" FontFamily="Bahnschrift" FontSize="13" FontAttributes="Bold" TextColor="#334B54" />
                            <Label Text="Available soon" FontSize="11" TextColor="#7A8D95" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="1"
                x:Name="ChatPane"
                BackgroundColor="#FFFFFF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0">
            <Grid RowDefinitions="0,*"
                  RowSpacing="0">
                <Border Grid.Row="0"
                        IsVisible="False"
                        BackgroundColor="#E8F1EFEB"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 30,30,0,0">
                    <Grid Padding="18,0" ColumnDefinitions="*,Auto">
                        <Label Text="CodexDesk"
                               FontFamily="Bahnschrift"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#526972"
                               VerticalTextAlignment="Center" />
                        <ContentView Grid.Column="1"
                                     x:Name="WindowDragRegion"
                                     WidthRequest="180"
                                     HeightRequest="48"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Start"
                                     BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Padding="0"
                      RowSpacing="0">
                    <Grid x:Name="CodexWorkspacePanel"
                          IsVisible="True"
                          RowDefinitions="*">
                        <Border x:Name="CodexPane"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 0">
                            <BlazorWebView x:Name="blazorWebView"
                                           HostPage="wwwroot/index.html">
                                <BlazorWebView.RootComponents>
                                    <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
                                </BlazorWebView.RootComponents>
                            </BlazorWebView>
                        </Border>
                    </Grid>

                    <Grid x:Name="WebBrowserWorkspacePanel"
                          IsVisible="False"
                          RowDefinitions="Auto,*,Auto"
                          RowSpacing="0">
                        <Border Margin="12,0,12,12"
                                Padding="10"
                                BackgroundColor="#ADFFFFFF"
                                Stroke="#14142324"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 0,0,22,22">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10">
                                <HorizontalStackLayout Spacing="8">
                                    <Border WidthRequest="38"
                                            HeightRequest="38"
                                            BackgroundColor="#1220252C"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12">
                                        <Button x:Name="BrowserBackButton"
                                                Text="&#x2190;"
                                                FontSize="14"
                                                BackgroundColor="Transparent"
                                                TextColor="#50656F"
                                                Padding="0"
                                                Clicked="OnBrowserBackClicked" />
                                    </Border>
                                    <Border WidthRequest="38"
                                            HeightRequest="38"
                                            BackgroundColor="#1220252C"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12">
                                        <Button x:Name="BrowserForwardButton"
                                                Text="&#x2192;"
                                                FontSize="14"
                                                BackgroundColor="Transparent"
                                                TextColor="#50656F"
                                                Padding="0"
                                                Clicked="OnBrowserForwardClicked" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Border Grid.Column="1"
                                        HeightRequest="42"
                                        BackgroundColor="#D1FFFFFF"
                                        Stroke="#1420252C"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10"
                                          Padding="14,0,6,0">
                                        <Border WidthRequest="22"
                                                HeightRequest="22"
                                                VerticalOptions="Center"
                                                BackgroundColor="#1F67801F"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 11">
                                            <Label Text="•"
                                                   FontSize="11"
                                                   TextColor="#1F6780"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                        </Border>
                                        <Entry Grid.Column="1"
                                               x:Name="BrowserAddressEntry"
                                               Placeholder="https://www.google.com/"
                                               FontFamily="Bahnschrift"
                                               FontSize="14"
                                               TextColor="#536972"
                                               PlaceholderColor="#6B8793"
                                               ClearButtonVisibility="WhileEditing"
                                               ReturnType="Go"
                                               Completed="OnBrowserAddressEntryCompleted"
                                               Focused="OnBrowserAddressEntryFocused"
                                               Unfocused="OnBrowserAddressEntryUnfocused"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="2"
                                                x:Name="BrowserGoButton"
                                                Text="Open"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="14,0"
                                                HeightRequest="32"
                                                CornerRadius="999"
                                                BackgroundColor="#1F6780"
                                                TextColor="#FFFFFF"
                                                Clicked="OnBrowserAddressGoClicked"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <HorizontalStackLayout Grid.Column="2"
                                                       Spacing="8">
                                    <Button x:Name="WebViewNetworkCaptureToggleButton"
                                            Text="Capture OFF"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1220252C"
                                            TextColor="#50656F"
                                            Clicked="OnWebViewNetworkCaptureToggleClicked" />
                                    <Button x:Name="BrowserFocusButton"
                                            Text="Focus"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1220252C"
                                            TextColor="#50656F"
                                            Clicked="OnBrowserFocusClicked" />
                                    <Button x:Name="WebViewInspectorToggleButton"
                                            Text="Inspect OFF"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1220252C"
                                            TextColor="#50656F"
                                            Clicked="OnWebViewInspectorToggleClicked" />
                                    <Button x:Name="BrowserCookieButton"
                                            Text="Cookie"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1220252C"
                                            TextColor="#50656F"
                                            Clicked="OnBrowserCookieClicked" />
                                    <Button x:Name="BrowserRequestButton"
                                            Text="Request"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1F6780"
                                            TextColor="#FFFFFF"
                                            Clicked="OnBrowserRequestClicked" />
                                    <Button x:Name="BrowserSnapshotButton"
                                            Text="Snapshot"
                                            FontFamily="Bahnschrift"
                                            FontSize="12"
                                            Padding="14,9"
                                            CornerRadius="12"
                                            BackgroundColor="#1220252C"
                                            TextColor="#50656F"
                                            Clicked="OnBrowserSnapshotClicked" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                x:Name="BrowserPane"
                                Margin="12,0,12,0"
                                BackgroundColor="#96FFFFFF"
                                Stroke="#14142324"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24">
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition x:Name="InterceptQueuePanelColumn"
                                                      Width="0" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Margin="0"
                                        BackgroundColor="#BFFFFFFF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 24,0,0,24">
                                    <Grid>
                                        <WebView x:Name="BrowserWebView"
                                                 Navigating="OnBrowserWebViewNavigating"
                                                 Navigated="OnBrowserWebViewNavigated"
                                                 Focused="OnBrowserWebViewFocused"
                                                 Unfocused="OnBrowserWebViewUnfocused" />
                                        <Grid IsVisible="False"
                                              HeightRequest="0">
                                            <Label x:Name="BrowserStatusLabel"
                                                   Text="WebView is idle." />
                                            <Label x:Name="BrowserUrlLabel"
                                                   Text="about:blank" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        BackgroundColor="#F4FAFB"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 0">
                                    <Grid RowDefinitions="Auto,*,Auto"
                                          Padding="0,10">
                                        <BoxView Grid.RowSpan="3"
                                                 WidthRequest="1"
                                                 HorizontalOptions="Start"
                                                 Color="#1820252C" />
                                        <Border x:Name="InterceptRailCountBadge"
                                                Grid.Row="0"
                                                WidthRequest="16"
                                                HeightRequest="16"
                                                Margin="2,0,2,0"
                                                Padding="0"
                                                BackgroundColor="#1F6780"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">
                                            <Label x:Name="InterceptRailCountLabel"
                                                   Text="0"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   TextColor="#FFFFFF" />
                                        </Border>
                                        <Grid Grid.Row="1"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center">
                                            <Button x:Name="InterceptSideToggleButton"
                                                    Text="&gt;"
                                                    FontFamily="Bahnschrift"
                                                    FontSize="14"
                                                    WidthRequest="20"
                                                    HeightRequest="88"
                                                    Padding="0"
                                                    CornerRadius="0"
                                                    BackgroundColor="#00FFFFFF"
                                                    TextColor="#50656F"
                                                    Clicked="OnInterceptSideToggleClicked" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        x:Name="InterceptQueuePanel"
                                        BackgroundColor="#F7FBFC"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 0,24,24,0">
                                    <Grid RowDefinitions="Auto,Auto,*,Auto"
                                          RowSpacing="0">
                                        <VerticalStackLayout Padding="16,16,16,10"
                                                             Spacing="6">
                                            <Label Text="Intercept Queue"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#173844" />
                                            <Label x:Name="InterceptStatusLabel"
                                                   Text="Waiting for WebView2 attach."
                                                   FontFamily="Bahnschrift"
                                                   FontSize="12"
                                                   TextColor="#30505D" />
                                            <Label x:Name="InterceptDetailLabel"
                                                   Text="0 pending | 0 paused | none"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   TextColor="#6A818A"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <Grid Grid.Row="1"
                                              Margin="16,0,16,12"
                                              ColumnDefinitions="Auto,*"
                                              ColumnSpacing="10">
                                            <Button x:Name="InterceptToggleButton"
                                                    Text="Intercept OFF"
                                                    FontFamily="Bahnschrift"
                                                    FontSize="12"
                                                    Padding="14,8"
                                                    CornerRadius="12"
                                                    BackgroundColor="#EEF3F6"
                                                    TextColor="#31474F"
                                                    Clicked="OnInterceptToggleClicked" />
                                            <Border Grid.Column="1"
                                                    Padding="10,8"
                                                    BackgroundColor="#1220252C"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12">
                                                <Label x:Name="InterceptCountLabel"
                                                       Text="0 pending"
                                                       FontFamily="Bahnschrift"
                                                       FontSize="12"
                                                       TextColor="#35515D" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="2"
                                              Padding="16,0,16,12"
                                              RowDefinitions="140,Auto,Auto,Auto,*,Auto"
                                              RowSpacing="10">
                                            <CollectionView x:Name="InterceptQueueCollection"
                                                            SelectionMode="Single"
                                                            SelectionChanged="OnInterceptQueueSelectionChanged">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8"
                                                                Padding="12"
                                                                BackgroundColor="#FFFFFFFF"
                                                                Stroke="#1420252C"
                                                                StrokeThickness="1"
                                                                StrokeShape="RoundRectangle 14">
                                                            <VerticalStackLayout Spacing="4">
                                                                <Label Text="{Binding Method}"
                                                                       FontFamily="Bahnschrift"
                                                                       FontSize="11"
                                                                       FontAttributes="Bold"
                                                                       TextColor="#173844" />
                                                                <Label Text="{Binding Url}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="11"
                                                                       TextColor="#50656F"
                                                                       LineBreakMode="TailTruncation"
                                                                       MaxLines="2" />
                                                                <Label Text="{Binding Status}"
                                                                       FontFamily="Bahnschrift"
                                                                       FontSize="11"
                                                                       TextColor="#768A93" />
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>

                                            <Label Grid.Row="1"
                                                   Text="Method / URL"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="11"
                                                   TextColor="#667882" />
                                            <Button Grid.Row="1"
                                                    x:Name="InterceptCopySummaryButton"
                                                    Text="Copy"
                                                    FontFamily="Bahnschrift"
                                                    FontSize="11"
                                                    Padding="10,4"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Center"
                                                    CornerRadius="10"
                                                    BackgroundColor="#EEF3F6"
                                                    TextColor="#31474F"
                                                    Clicked="OnCopyInterceptSummaryClicked" />
                                            <Editor Grid.Row="2"
                                                   x:Name="InterceptSelectedSummaryLabel"
                                                   Text="선택된 요청 없음"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   TextColor="#22363F"
                                                   IsReadOnly="True"
                                                   AutoSize="TextChanges"
                                                   BackgroundColor="#FFFFFFFF"
                                                   Placeholder="선택된 요청 없음" />
                                            <Label Grid.Row="3"
                                                   Text="Headers"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="11"
                                                   TextColor="#667882" />
                                            <Editor Grid.Row="4"
                                                    x:Name="InterceptSelectedHeadersEditor"
                                                    IsReadOnly="True"
                                                    AutoSize="TextChanges"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    TextColor="#30464F"
                                                    BackgroundColor="#FFFFFFFF" />
                                            <Editor Grid.Row="5"
                                                    x:Name="InterceptSelectedBodyEditor"
                                                    IsReadOnly="True"
                                                    AutoSize="TextChanges"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    TextColor="#30464F"
                                                    BackgroundColor="#FFFFFFFF"
                                                    Placeholder="Body" />
                                        </Grid>

                                        <Grid Grid.Row="3"
                                              Padding="16,0,16,16"
                                              ColumnDefinitions="*,*,*"
                                              ColumnSpacing="10">
                                            <Button x:Name="InterceptForwardButton"
                                                    Text="Forward"
                                                    FontFamily="Bahnschrift"
                                                    FontSize="12"
                                                    CornerRadius="12"
                                                    BackgroundColor="#1F6780"
                                                    TextColor="#FFFFFF"
                                                    Clicked="OnInterceptForwardClicked" />
                                            <Button Grid.Column="1"
                                                    x:Name="InterceptForwardAllButton"
                                                    Text="Forward All"
                                                    FontFamily="Bahnschrift"
                                                    FontSize="12"
                                                    CornerRadius="12"
                                                    BackgroundColor="#35515D"
                                                    TextColor="#FFFFFF"
                                                    Clicked="OnInterceptForwardAllClicked" />
                                            <Button Grid.Column="2"
                                                    x:Name="InterceptDropButton"
                                                    Text="Drop"
                                                    FontFamily="Bahnschrift"

                                                        CornerRadius="12"
                                                        BackgroundColor="#EEF3F6"
                                                        TextColor="#31474F"
                                                        Clicked="OnNetworkFilterClicked" />
                                                <Button x:Name="NetworkFilterCssButton"
                                                        ClassId="Css"
                                                        Text="CSS"
                                                        FontFamily="Bahnschrift"
                                                        FontSize="12"
                                                        Padding="12,8"
                                                        CornerRadius="12"
                                                        BackgroundColor="#EEF3F6"
                                                        TextColor="#31474F"
                                                        Clicked="OnNetworkFilterClicked" />
                                                <Button x:Name="NetworkFilterImageButton"
                                                        ClassId="Image"
                                                        Text="Image"
                                                        FontFamily="Bahnschrift"
                                                        FontSize="12"
                                                        Padding="12,8"
                                                        CornerRadius="12"
                                                        BackgroundColor="#EEF3F6"
                                                        TextColor="#31474F"
                                                        Clicked="OnNetworkFilterClicked" />
                                                <Button x:Name="NetworkFilterMediaButton"
                                                        ClassId="Media"
                                                        Text="Media"
                                                        FontFamily="Bahnschrift"
                                                        FontSize="12"
                                                        Padding="12,8"
                                                        CornerRadius="12"
                                                        BackgroundColor="#EEF3F6"
                                                        TextColor="#31474F"
                                                        Clicked="OnNetworkFilterClicked" />
                                                <Button x:Name="NetworkFilterFontButton"
                                                        ClassId="Font"
                                                        Text="Font"
                                                        FontFamily="Bahnschrift"
                                                        FontSize="12"
                                                        Padding="12,8"
                                                        CornerRadius="12"
                                                        BackgroundColor="#EEF3F6"
                                                        TextColor="#31474F"
                                                        Clicked="OnNetworkFilterClicked" />
                                                <Button x:Name="NetworkFilterErrorButton"
                                                        ClassId="Error"
                                                        Text="Error"
                                                        FontFamily="Bahnschrift"
                                                        FontSize="12"
                                                        Padding="12,8"
                                                        CornerRadius="12"
                                                        BackgroundColor="#EEF3F6"
                                                        TextColor="#31474F"
                                                        Clicked="OnNetworkFilterClicked" />
                                                <Button x:Name="NetworkFilterOtherButton"
                                                        ClassId="Other"
                                                        Text="Other"
                                                        FontFamily="Bahnschrift"
                                                        FontSize="12"
                                                        Padding="12,8"
                                                        CornerRadius="12"
                                                        BackgroundColor="#EEF3F6"
                                                        TextColor="#31474F"
                                                        Clicked="OnNetworkFilterClicked" />
                                            </HorizontalStackLayout>
                                        </ScrollView>
                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Padding="14,0"
                                          HeightRequest="38"
                                          ColumnDefinitions="52,74,72,*,68,68"
                                          ColumnSpacing="10"
                                          BackgroundColor="#0A18252C">
                                        <Label Grid.Column="0" Text="#" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="Status" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="2" Text="Method" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="3" Text="Host / Path" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="4" Text="Size" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                        <Label Grid.Column="5" Text="Time" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                    </Grid>

                                    <CollectionView Grid.Row="3"
                                                    x:Name="WebViewNetworkListView"
                                                    SelectionMode="Single"
                                                    SelectionChanged="OnWebViewNetworkSelectionChanged"
                                                    Scrolled="OnWebViewNetworkListScrolled"
                                                    Focused="OnWebViewNetworkListFocused"
                                                    Unfocused="OnWebViewNetworkListUnfocused"
                                                    VerticalScrollBarVisibility="Default"
                                                    BackgroundColor="#70FFFFFF">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="14,0"
                                                      HeightRequest="58"
                                                      ColumnDefinitions="52,74,72,*,68,68"
                                                      ColumnSpacing="10">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Buttons="Secondary"
                                                                              Tapped="OnWebViewNetworkItemSecondaryTapped" />
                                                    </Grid.GestureRecognizers>
                                                    <Label Grid.Column="0"
                                                           Text="{Binding IndexDisplay}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextColor="#60717A"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding StatusDisplay}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextColor="{Binding StatusColor}"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center" />
                                                    <Label Grid.Column="2"
                                                           Text="{Binding MethodDisplay}"
                                                           FontFamily="Bahnschrift"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           TextColor="#1C6780"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center" />
                                                    <Grid Grid.Column="3"
                                                          RowDefinitions="Auto,Auto"
                                                          RowSpacing="2"
                                                          VerticalOptions="Center">
                                                        <Label Grid.Row="0"
                                                               Text="{Binding HostDisplay}"
                                                               FontFamily="Bahnschrift"
                                                               FontSize="12"
                                                               TextColor="#18252C"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1" />
                                                        <Label Grid.Row="1"
                                                               Text="{Binding FullUrlDisplay}"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               TextColor="#71858E"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1" />
                                                    </Grid>
                                                    <Label Grid.Column="4"
                                                           Text="{Binding SizeDisplay}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextColor="#60717A"
                                                           HorizontalTextAlignment="End"
                                                           VerticalTextAlignment="Center" />
                                                    <Label Grid.Column="5"
                                                           Text="{Binding TimeDisplay}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextColor="#60717A"
                                                           HorizontalTextAlignment="End"
                                                           VerticalTextAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="#9FFFFFFF"
                                    Stroke="#1418252C"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 24">
                                <Grid RowDefinitions="Auto,Auto,Auto,*"
                                      RowSpacing="0">
                                    <Grid Padding="14,12"
                                          ColumnDefinitions="*,Auto"
                                          BackgroundColor="#B8FFFFFF">
                                        <Label x:Name="SelectedNetworkSummaryLabel"
                                               Text="선택된 요청 없음"
                                               FontFamily="Bahnschrift"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#1D3440"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <Button Grid.Column="1"
                                                x:Name="CopySelectedNetworkDetailsButton"
                                                Text="전체 복사"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="12,8"
                                                CornerRadius="12"
                                                BackgroundColor="#EEF3F6"
                                                TextColor="#31474F"
                                                IsEnabled="False"
                                                Clicked="OnCopySelectedNetworkDetailsClicked" />
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Padding="12"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="8"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="8"
                                          BackgroundColor="#AAFFFFFF">
                                        <Border BackgroundColor="#1220252C"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="10,9">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="METHOD"
                                                       FontFamily="Bahnschrift"
                                                       FontSize="11"
                                                       TextColor="#667882" />
                                                <Label x:Name="SelectedNetworkMethodLabel"
                                                       Text="-"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       TextColor="#18252C" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Column="1"
                                                BackgroundColor="#1220252C"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="10,9">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="STATUS"
                                                       FontFamily="Bahnschrift"
                                                       FontSize="11"
                                                       TextColor="#667882" />
                                                <Label x:Name="SelectedNetworkStatusLabel"
                                                       Text="-"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       TextColor="#1C6780" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="1"
                                                BackgroundColor="#1220252C"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="10,9">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="SIZE"
                                                       FontFamily="Bahnschrift"
                                                       FontSize="11"
                                                       TextColor="#667882" />
                                                <Label x:Name="SelectedNetworkSizeLabel"
                                                       Text="-"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       TextColor="#18252C" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Row="1"
                                                Grid.Column="1"
                                                BackgroundColor="#1220252C"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="10,9">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="TIME"
                                                       FontFamily="Bahnschrift"
                                                       FontSize="11"
                                                       TextColor="#667882" />
                                                <Label x:Name="SelectedNetworkTimeLabel"
                                                       Text="-"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       TextColor="#18252C" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Padding="10,10,10,0"
                                          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="4"
                                          BackgroundColor="#84FFFFFF">
                                        <Border x:Name="NetworkDetailHeadersButton"
                                                ClassId="Headers"
                                                Padding="12,9"
                                                BackgroundColor="#D6FFFFFF"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnNetworkDetailTabTapped" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="NetworkDetailHeadersLabel"
                                                   Text="Headers"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   InputTransparent="True"
                                                   TextColor="#18252C" />
                                        </Border>
                                        <Border Grid.Column="1"
                                                x:Name="NetworkDetailBodyButton"
                                                ClassId="Body"
                                                Padding="12,9"
                                                BackgroundColor="#1220252C"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnNetworkDetailTabTapped" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="NetworkDetailBodyLabel"
                                                   Text="Body"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="13"
                                                   InputTransparent="True"
                                                   TextColor="#667882" />
                                        </Border>
                                        <Border Grid.Column="2"
                                                x:Name="NetworkDetailRawButton"
                                                ClassId="Raw"
                                                Padding="12,9"
                                                BackgroundColor="#1220252C"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnNetworkDetailTabTapped" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="NetworkDetailRawLabel"
                                                   Text="Raw"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="13"
                                                   InputTransparent="True"
                                                   TextColor="#667882" />
                                        </Border>
                                        <Border Grid.Column="3"
                                                x:Name="NetworkDetailJsonButton"
                                                ClassId="Json"
                                                Padding="12,9"
                                                BackgroundColor="#1220252C"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnNetworkDetailTabTapped" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="NetworkDetailJsonLabel"
                                                   Text="JSON"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="13"
                                                   InputTransparent="True"
                                                   TextColor="#667882" />
                                        </Border>
                                        <Border Grid.Column="4"
                                                x:Name="NetworkDetailTimelineButton"
                                                ClassId="Timeline"
                                                Padding="12,9"
                                                BackgroundColor="#1220252C"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnNetworkDetailTabTapped" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="NetworkDetailTimelineLabel"
                                                   Text="Timeline"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="13"
                                                   InputTransparent="True"
                                                   TextColor="#667882" />
                                        </Border>
                                        <Border Grid.Column="5"
                                                x:Name="NetworkDetailCookiesButton"
                                                ClassId="Cookies"
                                                Padding="12,9"
                                                BackgroundColor="#1220252C"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnNetworkDetailTabTapped" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="NetworkDetailCookiesLabel"
                                                   Text="Cookies"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="13"
                                                   InputTransparent="True"
                                                   TextColor="#667882" />
                                        </Border>
                                    </Grid>

                                    <ScrollView Grid.Row="3"
                                                Orientation="Vertical">
                                        <VerticalStackLayout Spacing="12"
                                                             Padding="12">
                                            <Button x:Name="NetworkUrlDecodeToggleButton"
                                                    Text="URL Decode"
                                                    FontFamily="Bahnschrift"
                                                    FontSize="12"
                                                    Padding="12,8"
                                                    CornerRadius="12"
                                                    BackgroundColor="#EEF3F6"
                                                    TextColor="#31474F"
                                                    HorizontalOptions="Start"
                                                    IsEnabled="False"
                                                    Clicked="OnNetworkUrlDecodeToggleClicked" />
                                            <Label x:Name="WebViewNetworkPrimaryDetailTitleLabel" Text="Request Headers" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" />
                                            <Border BackgroundColor="#D6FFFFFF" Stroke="#12142324" StrokeThickness="1" StrokeShape="RoundRectangle 12" MinimumHeightRequest="180">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnRequestHeadersPanelTapped" />
                                                </Border.GestureRecognizers>
                                                <ScrollView Orientation="Vertical" x:Name="WebViewNetworkRequestHeadersScrollView" VerticalScrollBarVisibility="Default">
                                                    <Label x:Name="WebViewNetworkRequestHeadersLabel" Margin="10,8" FontFamily="Consolas" FontSize="11" TextColor="#14313A" LineBreakMode="CharacterWrap" Text="Request headers" HandlerChanged="OnNetworkDetailLabelHandlerChanged" />
                                                </ScrollView>
                                            </Border>

                                            <Label x:Name="WebViewNetworkSecondaryDetailTitleLabel" Text="Response Headers" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" />
                                            <Border BackgroundColor="#D6FFFFFF" Stroke="#12142324" StrokeThickness="1" StrokeShape="RoundRectangle 12" MinimumHeightRequest="180">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnRequestBodyPanelTapped" />
                                                </Border.GestureRecognizers>
                                                <ScrollView Orientation="Vertical" x:Name="WebViewNetworkRequestBodyScrollView" VerticalScrollBarVisibility="Default">
                                                    <Label x:Name="WebViewNetworkRequestBodyLabel" Margin="10,8" FontFamily="Consolas" FontSize="11" TextColor="#14313A" LineBreakMode="CharacterWrap" Text="Request body" HandlerChanged="OnNetworkDetailLabelHandlerChanged" />
                                                </ScrollView>
                                            </Border>
                                        </VerticalStackLayout>
                                    </ScrollView>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="NetworkCaptureSnapshotConfirmModal"
                              Grid.RowSpan="2"
                              IsVisible="False"
                              ZIndex="100"
                              BackgroundColor="#660E171B"
                              Padding="36">
                            <Border BackgroundColor="#F4FBFCFC"
                                    Stroke="#1A18252C"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    MaximumWidthRequest="920"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Grid RowDefinitions="Auto,Auto,*,Auto"
                                      RowSpacing="14"
                                      Padding="18">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Network Capture Saved"
                                               FontFamily="Bahnschrift"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#18252C" />
                                        <Label Text="방금 저장한 network capture를 Codex로 분석 시작할까요?"
                                               FontFamily="Bahnschrift"
                                               FontSize="13"
                                               TextColor="#637780" />
                                    </VerticalStackLayout>

                                    <Border Grid.Row="1"
                                            BackgroundColor="#EFFFFFFF"
                                            Stroke="#12142324"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12">
                                        <VerticalStackLayout Spacing="8">
                                            <Label x:Name="NetworkCaptureSnapshotFolderLabel"
                                                   Text="Folder: -"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextColor="#30464F"
                                                   LineBreakMode="TailTruncation" />
                                            <Label x:Name="NetworkCaptureSnapshotPathLabel"
                                                   Text="Path: -"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextColor="#30464F"
                                                   LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Row="2"
                                            BackgroundColor="#DFFFFFFF"
                                            Stroke="#1420252C"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            MinimumHeightRequest="220">
                                        <Editor x:Name="NetworkCaptureSnapshotPromptEditor"
                                                Margin="12"
                                                Placeholder="Codex에게 물어볼 질문"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                TextColor="#14313A"
                                                PlaceholderColor="#7A8F98"
                                                AutoSize="Disabled" />
                                    </Border>

                                    <HorizontalStackLayout Grid.Row="3"
                                                           Spacing="10"
                                                           HorizontalOptions="End">
                                        <Button Text="No"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="18,9"
                                                CornerRadius="12"
                                                BackgroundColor="#EEF3F6"
                                                TextColor="#31474F"
                                                Clicked="OnCancelNetworkCaptureSnapshotAnalysisClicked" />
                                        <Button Text="Yes"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="18,9"
                                                CornerRadius="12"
                                                BackgroundColor="#1F6780"
                                                TextColor="#FFFFFF"
                                                Clicked="OnConfirmNetworkCaptureSnapshotAnalysisClicked" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid IsVisible="False"
              HeightRequest="0"
              ColumnDefinitions="Auto,Auto"
              ColumnSpacing="0">
            <ContentView Grid.Column="0"
                         x:Name="ResizeHandle"
                         BackgroundColor="Transparent">
                <BoxView x:Name="ResizeHandleGrip"
                         BackgroundColor="#B0BEC5"
                         WidthRequest="6"
                         HorizontalOptions="Center"
                         VerticalOptions="Fill" />
            </ContentView>
            <ContentView Grid.Column="1"
                         x:Name="RightResizeHandle"
                         BackgroundColor="Transparent">
                <BoxView x:Name="RightResizeHandleGrip"
                         BackgroundColor="#D0DEE5"
                         WidthRequest="4"
                         HorizontalOptions="Center"
                         VerticalOptions="Fill" />
            </ContentView>
        </Grid>
    </Grid>
</ContentPage>

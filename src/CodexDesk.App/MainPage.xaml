                                                </ScrollView>
                                            </Border>

                                            <Label Text="Response Body" FontFamily="Bahnschrift" FontSize="11" TextColor="#667882" />
                                            <Border BackgroundColor="#D6FFFFFF" Stroke="#12142324" StrokeThickness="1" StrokeShape="RoundRectangle 12" MinimumHeightRequest="140">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnResponseBodyPanelTapped" />
                                                </Border.GestureRecognizers>
                                                <ScrollView Orientation="Vertical" x:Name="WebViewNetworkResponseBodyScrollView" VerticalScrollBarVisibility="Default">
                                                    <Label x:Name="WebViewNetworkResponseBodyLabel" Margin="10,8" FontFamily="Consolas" FontSize="11" TextColor="#14313A" LineBreakMode="CharacterWrap" Text="Response body" />
                                                </ScrollView>
                                            </Border>
                                        </VerticalStackLayout>
                                    </ScrollView>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="NetworkCaptureSnapshotConfirmModal"
                              Grid.RowSpan="2"
                              IsVisible="False"
                              ZIndex="100"
                              BackgroundColor="#660E171B"
                              Padding="36">
                            <Border BackgroundColor="#F4FBFCFC"
                                    Stroke="#1A18252C"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    MaximumWidthRequest="920"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Grid RowDefinitions="Auto,Auto,*,Auto"
                                      RowSpacing="14"
                                      Padding="18">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Network Capture Saved"
                                               FontFamily="Bahnschrift"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#18252C" />
                                        <Label Text="방금 저장한 network capture를 Codex로 분석 시작할까요?"
                                               FontFamily="Bahnschrift"
                                               FontSize="13"
                                               TextColor="#637780" />
                                    </VerticalStackLayout>

                                    <Border Grid.Row="1"
                                            BackgroundColor="#EFFFFFFF"
                                            Stroke="#12142324"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12">
                                        <VerticalStackLayout Spacing="8">
                                            <Label x:Name="NetworkCaptureSnapshotFolderLabel"
                                                   Text="Folder: -"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextColor="#30464F"
                                                   LineBreakMode="TailTruncation" />
                                            <Label x:Name="NetworkCaptureSnapshotPathLabel"
                                                   Text="Path: -"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextColor="#30464F"
                                                   LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Row="2"
                                            BackgroundColor="#DFFFFFFF"
                                            Stroke="#1420252C"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            MinimumHeightRequest="220">
                                        <Editor x:Name="NetworkCaptureSnapshotPromptEditor"
                                                Margin="12"
                                                Placeholder="Codex에게 물어볼 질문"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                TextColor="#14313A"
                                                PlaceholderColor="#7A8F98"
                                                AutoSize="Disabled" />
                                    </Border>

                                    <HorizontalStackLayout Grid.Row="3"
                                                           Spacing="10"
                                                           HorizontalOptions="End">
                                        <Button Text="No"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="18,9"
                                                CornerRadius="12"
                                                BackgroundColor="#EEF3F6"
                                                TextColor="#31474F"
                                                Clicked="OnCancelNetworkCaptureSnapshotAnalysisClicked" />
                                        <Button Text="Yes"
                                                FontFamily="Bahnschrift"
                                                FontSize="12"
                                                Padding="18,9"
                                                CornerRadius="12"
                                                BackgroundColor="#1F6780"
                                                TextColor="#FFFFFF"
                                                Clicked="OnConfirmNetworkCaptureSnapshotAnalysisClicked" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid IsVisible="False"
              HeightRequest="0"
              ColumnDefinitions="Auto,Auto"
              ColumnSpacing="0">
            <ContentView Grid.Column="0"
                         x:Name="ResizeHandle"
                         BackgroundColor="Transparent">
                <BoxView x:Name="ResizeHandleGrip"
                         BackgroundColor="#B0BEC5"
                         WidthRequest="6"
                         HorizontalOptions="Center"
                         VerticalOptions="Fill" />
            </ContentView>
            <ContentView Grid.Column="1"
                         x:Name="RightResizeHandle"
                         BackgroundColor="Transparent">
                <BoxView x:Name="RightResizeHandleGrip"
                         BackgroundColor="#D0DEE5"
                         WidthRequest="4"
                         HorizontalOptions="Center"
                         VerticalOptions="Fill" />
            </ContentView>
        </Grid>
    </Grid>
</ContentPage>

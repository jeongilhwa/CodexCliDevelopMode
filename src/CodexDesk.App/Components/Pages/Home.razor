    private async Task SelectApprovalOptionAsync(string selectedValue)
    {
        var tab = ActiveTab;
        tab.IsApprovalModalOpen = false;
        tab.PendingApprovalRequest = null;
        tab.Messages.Add(ChatMessage.System($"Approval selected: {selectedValue}"));
        await SendPromptAsync(selectedValue, addAsUserMessage: false, tab);
    }

    private async Task RejectApprovalAsync()
    {
        var tab = ActiveTab;
        if (!tab.IsApprovalModalOpen)
        {
            return;
        }

        tab.IsApprovalModalOpen = false;
        tab.PendingApprovalRequest = null;
        tab.Messages.Add(ChatMessage.System("Approval rejected."));
        await SendPromptAsync("n", addAsUserMessage: false, tab);
    }

    private async Task AddCodexPromptMacroAsync()
    {
        if (!CodexPromptMacroService.TryAdd(
                NewCodexMacroName,
                NewCodexMacroText,
                NewCodexMacroAutoSend,
                out var errorMessage))
        {
            if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                ActiveTab.Messages.Add(ChatMessage.System(errorMessage));
            }

            return;
        }

        CodexPromptMacros = CodexPromptMacroService.Macros.ToList();
        NewCodexMacroName = string.Empty;
        NewCodexMacroText = string.Empty;
        NewCodexMacroAutoSend = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveCodexPromptMacroAsync(int index)
    {
        if (!CodexPromptMacroService.RemoveAt(index))
        {
            return;
        }

        if (EditingMacroIndex == index)
        {
            CancelEditCodexPromptMacro();
        }
        else if (EditingMacroIndex.HasValue && EditingMacroIndex > index)
        {
            EditingMacroIndex--;
        }

        CodexPromptMacros = CodexPromptMacroService.Macros.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private void BeginEditCodexPromptMacro(int index)
    {
        if (index < 0 || index >= CodexPromptMacros.Count)
        {
            return;
        }

        var macro = CodexPromptMacros[index];
        EditingMacroIndex = index;
        EditingCodexMacroName = macro.Name;
        EditingCodexMacroText = macro.Text;
        EditingCodexMacroAutoSend = macro.AutoSend;
    }

    private void CancelEditCodexPromptMacro()
    {
        EditingMacroIndex = null;
        EditingCodexMacroName = string.Empty;
        EditingCodexMacroText = string.Empty;
        EditingCodexMacroAutoSend = false;
    }

    private async Task SaveEditedCodexPromptMacroAsync()
    {
        if (!EditingMacroIndex.HasValue)
        {
            return;
        }

        if (!CodexPromptMacroService.TryUpdateAt(
                EditingMacroIndex.Value,
                EditingCodexMacroName,
                EditingCodexMacroText,
                EditingCodexMacroAutoSend,
                out var errorMessage))
        {
            if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                ActiveTab.Messages.Add(ChatMessage.System(errorMessage));
            }

            await InvokeAsync(StateHasChanged);
            return;
        }

        CodexPromptMacros = CodexPromptMacroService.Macros.ToList();
        CancelEditCodexPromptMacro();
        await InvokeAsync(StateHasChanged);
    }

    private void BeginMacroDrag(int index, DragEventArgs args)
    {
        if (ActiveTab.IsBusy || index < 0 || index >= CodexPromptMacros.Count)
        {
            return;
        }

        if (args.DataTransfer is not null)
        {
            args.DataTransfer.EffectAllowed = "move";
            args.DataTransfer.DropEffect = "move";
        }

        DraggingMacroIndex = index;
        DragOverMacroIndex = index;
    }

    private void SetMacroDragOver(int index, DragEventArgs args)
    {
        if (!DraggingMacroIndex.HasValue || index < 0 || index >= CodexPromptMacros.Count)
        {
            return;
        }

        if (args.DataTransfer is not null)
        {
            args.DataTransfer.DropEffect = "move";
        }

        DragOverMacroIndex = index;
    }

    private async Task CompleteMacroDropAsync(int targetIndex)
    {
        if (!DraggingMacroIndex.HasValue)
        {
            return;
        }

        var fromIndex = DraggingMacroIndex.Value;
        if (targetIndex < 0 || targetIndex >= CodexPromptMacros.Count)
        {
            ClearMacroDragState();
            return;
        }

        if (fromIndex != targetIndex && CodexPromptMacroService.Move(fromIndex, targetIndex))
        {
            CodexPromptMacros = CodexPromptMacroService.Macros.ToList();
            CancelEditCodexPromptMacro();
        }

        ClearMacroDragState();
        await InvokeAsync(StateHasChanged);
    }

    private void BeginPointerMacroDrag(int index, MouseEventArgs args)
    {
        if (ActiveTab.IsBusy || EditingMacroIndex.HasValue || args.Button != 0 || index < 0 || index >= CodexPromptMacros.Count)
        {
            return;
        }

        IsPointerMacroDragActive = true;
        PointerMacroDragIndex = index;
        DraggingMacroIndex = index;
        DragOverMacroIndex = index;
    }

    private async Task HoverPointerMacroDragAsync(int index)
    {
        if (!IsPointerMacroDragActive || !PointerMacroDragIndex.HasValue || index < 0 || index >= CodexPromptMacros.Count)
        {
            return;
        }

        var fromIndex = PointerMacroDragIndex.Value;
        if (fromIndex == index)
        {
            return;
        }

        if (!CodexPromptMacroService.Move(fromIndex, index))
        {
            return;
        }

        CodexPromptMacros = CodexPromptMacroService.Macros.ToList();
        PointerMacroDragIndex = index;
        DraggingMacroIndex = index;
        DragOverMacroIndex = index;
        CancelEditCodexPromptMacro();
        await InvokeAsync(StateHasChanged);
    }

    private void EndPointerMacroDrag()
    {
        if (!IsPointerMacroDragActive)
        {
            return;
        }

        IsPointerMacroDragActive = false;
        PointerMacroDragIndex = null;
        ClearMacroDragState();
    }

    private void ClearMacroDragState()
    {
        DraggingMacroIndex = null;
        DragOverMacroIndex = null;
        IsPointerMacroDragActive = false;
        PointerMacroDragIndex = null;
    }

    private async Task ApplyCodexPromptMacroAsync(CodexPromptMacroItem macro)
    {
        if (string.IsNullOrWhiteSpace(macro.Text))
        {
            return;
        }

        var tab = ActiveTab;

        var insertedAtFocusedInput = await TryInsertMacroIntoFocusedInputAsync(macro.Text);
        if (!insertedAtFocusedInput)
        {
            tab.DraftMessage = string.IsNullOrWhiteSpace(tab.DraftMessage)
                ? macro.Text
                : $"{tab.DraftMessage}{Environment.NewLine}{macro.Text}";
        }

        if (macro.AutoSend && !tab.IsBusy)
        {
            await SendAsync();
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> TryInsertMacroIntoFocusedInputAsync(string macroText)
    {
        try
        {
            return await JS.InvokeAsync<bool>("codexDesk.insertTextIntoFocusedInput", macroText);
        }
        catch
        {
            return false;
        }
    }

    private void CancelRun()
    {
        ActiveTab.RunCts?.Cancel();
    }

    public void Dispose()
    {
        CodexPromptMacroService.KeyObserved -= OnMacroKeyObserved;
        CodexPromptMacroService.PromptRequested -= OnExternalPromptRequested;
        _loadingIndicatorTimer?.Dispose();
        foreach (var tab in _tabs)
        {
            tab.RunCts?.Cancel();
            tab.RunCts?.Dispose();
        }
    }

    private void StartLoadingIndicator()
    {
        _loadingDotCount = 1;
        _loadingIndicatorTimer ??= new System.Threading.Timer(
            _ => _ = InvokeAsync(AdvanceLoadingIndicatorAsync),
            null,
            System.Threading.Timeout.Infinite,
            System.Threading.Timeout.Infinite);
        _loadingIndicatorTimer.Change(400, 400);
    }

    private void StopLoadingIndicatorIfIdle()
    {
        if (_tabs.Any(t => t.IsBusy))
        {
            return;
        }

        _loadingIndicatorTimer?.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
        _loadingDotCount = 1;
    }

    private Task AdvanceLoadingIndicatorAsync()
    {
        if (!_tabs.Any(t => t.IsBusy))
        {
            return Task.CompletedTask;
        }

        _loadingDotCount = _loadingDotCount % 3 + 1;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void AddNewTab()
    {
        _tabCounter++;
        var tab = new ChatTab(_tabCounter);
        _tabs.Add(tab);
        _activeTabId = tab.Id;
    }

    private void SwitchTab(string tabId)
    {
        if (_tabs.Any(t => t.Id == tabId))
        {
            _activeTabId = tabId;
        }
    }

    private void CloseTab(string tabId)
    {
        if (_tabs.Count <= 1)
        {
            return;
        }

        var tab = _tabs.FirstOrDefault(t => t.Id == tabId);
        if (tab is null)
        {
            return;
        }

        if (tab.IsBusy)
        {
            tab.RunCts?.Cancel();
        }

        tab.RunCts?.Dispose();
        var index = _tabs.IndexOf(tab);
        _tabs.Remove(tab);

        if (_activeTabId == tabId)
        {
            _activeTabId = _tabs[Math.Max(0, Math.Min(index, _tabs.Count - 1))].Id;
        }
    }

    private static void UpdateTabTitle(ChatTab tab)
    {
        var firstUserMsg = tab.Messages.FirstOrDefault(m => m.Role == "user");
        if (firstUserMsg is not null)
        {
            tab.Title = firstUserMsg.Content.Length > 24
                ? firstUserMsg.Content[..24] + "…"
                : firstUserMsg.Content;
        }
    }

    private sealed class ChatTab
    {
        public ChatTab(int tabNumber)
        {
            TabNumber = tabNumber;
            Title = $"Chat {tabNumber}";
        }

        public string Id { get; } = Guid.NewGuid().ToString("N");
        public int TabNumber { get; }
        public string Title { get; set; } = string.Empty;
        public string? ThreadId { get; set; }
        public IList<ChatMessage> Messages { get; } = new List<ChatMessage>();
        public string DraftMessage { get; set; } = string.Empty;
        public string PendingPromptNotice { get; set; } = string.Empty;
        public bool IsBusy { get; set; }
        public DateTimeOffset? BusyStartedAt { get; set; }
        public CancellationTokenSource? RunCts { get; set; }
        public bool IsApprovalModalOpen { get; set; }
        public CodexApprovalRequest? PendingApprovalRequest { get; set; }
    }
}

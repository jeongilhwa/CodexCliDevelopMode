@page "/"

@implements IDisposable
@inject CodexInteractiveChatService CodexCli
@inject CodexPromptMacroService CodexPromptMacroService
@inject IJSRuntime JS

<PageTitle>CodexDesk</PageTitle>

<div class="page" tabindex="0">
    <section class="hero">
        <div>
            <p class="eyebrow">Windows-only MAUI Blazor shell</p>
            <h1>CodexDesk</h1>
            <p class="lede">
                <code>codex exec</code>와 <code>codex exec resume</code>를 감싸서 별도 UI에서 Codex와 대화할 수 있게 만든 최소 시작점입니다.
                작업 폴더, 모델, 실행 모드를 바꿔가며 로컬 에이전트처럼 사용할 수 있습니다.
            </p>
        </div>

        <div class="status-card desktop-status-card">
            <div class="status-row">
                <span>Status</span>
                <strong>@StatusLabel</strong>
            </div>
            <button type="button" class="primary" @onclick="ShowCurrentCodexCmd">Show Current Codex CMD</button>
            <button type="button" class="ghost" @onclick="OpenSessionModal">설정</button>
        </div>

        <button type="button" class="ghost hamburger-button" @onclick="ToggleHamburger">
            ☰
        </button>
    </section>

    @if (IsHamburgerOpen)
    {
        <div class="hamburger-backdrop" @onclick="CloseHamburger">
            <div class="hamburger-panel panel" @onclick:stopPropagation="true">
                <div class="panel-header">
                    <h2>Menu</h2>
                    <button class="ghost close-hamburger-btn" @onclick="CloseHamburger">×</button>
                </div>
                <div class="status-card mobile-status-card">
                    <div class="status-row">
                        <span>Status</span>
                        <strong>@StatusLabel</strong>
                    </div>
                    <button type="button" class="primary" @onclick="ShowCurrentCodexCmd">Show Current Codex CMD</button>
                    <button type="button" class="ghost" @onclick="OpenSessionModal">설정</button>
                </div>
            </div>
        </div>
    }

    <section class="control-grid">
        <div class="panel chat-panel">
            <div class="panel-header">
                <h2>Conversation</h2>
                <p>첫 메시지는 <code>exec</code>, 이후에는 같은 thread id로 <code>resume</code>을 사용합니다.</p>
            </div>

            <div class="tab-bar">
                @foreach (var tab in _tabs)
                {
                    <button class="tab-item @(tab.Id == _activeTabId ? "active" : "")"
                            @onclick="() => SwitchTab(tab.Id)"
                            title="@(tab.ThreadId ?? "new conversation")">
                        <span class="tab-title">@tab.Title</span>
                        @if (tab.IsBusy)
                        {
                            <span class="tab-busy">●</span>
                        }
                        @if (_tabs.Count > 1)
                        {
                            <span class="tab-close" @onclick:stopPropagation="true" @onclick="() => CloseTab(tab.Id)">×</span>
                        }
                    </button>
                }
                <button class="tab-add" @onclick="AddNewTab" title="New chat tab">+</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(ActiveTab.PendingPromptNotice))
            {
                <div class="external-prompt-banner">
                    <strong>Codex 입력창에 프롬프트가 준비되었습니다.</strong>
                    <pre>@ActiveTab.PendingPromptNotice</pre>
                </div>
            }

            <div class="transcript">
                @if (ActiveTab.Messages.Count == 0)
                {
                    <div class="empty-state">
                        <h3>Start with a prompt</h3>
                        <p>질문을 입력하면 그대로 Codex에 전달됩니다.</p>
                    </div>
                }
                else
                {
                    @foreach (var message in ActiveTab.Messages)
                    {
                        <article class="@message.CssClass">
                            <header>
                                <strong>@message.RoleLabel</strong>
                                <span>@message.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                            </header>
                            <pre>@message.Content</pre>
                        </article>
                    }

                    @if (ActiveTab.IsBusy)
                    {
                        <article class="message system loading-message">
                            <header>
                                <strong>Codex</strong>
                                <span>@(ActiveTab.BusyStartedAt?.ToLocalTime().ToString("HH:mm:ss") ?? string.Empty)</span>
                            </header>
                            <pre>@BusyIndicatorText</pre>
                        </article>
                    }
                }
            </div>

            @if (CodexPromptMacros.Count > 0)
            {
                <div class="codex-macro-toolbar">
                    @foreach (var macro in CodexPromptMacros)
                    {
                        <button type="button" class="macro-shortcut-chip" @onclick="() => ApplyCodexPromptMacroAsync(macro)">
                            @macro.Name (@macro.Shortcut)
                        </button>
                    }
                </div>
            }

            <div class="composer">
                <label class="field">
                    <span>Prompt</span>
                    <textarea @bind="ActiveTab.DraftMessage" @bind:event="oninput" @onkeydown="HandlePromptKeyDown" placeholder="질문만 입력하세요." disabled="@ActiveTab.IsBusy"></textarea>
                </label>

                <div class="button-row">
                    <button type="button" class="primary" @onclick="SendAsync" disabled="@ActiveTab.IsBusy">Send</button>
                </div>
            </div>
        </div>
    </section>

    @if (IsSessionModalOpen)
    {
        <div class="session-modal-backdrop" @onclick="CloseSessionModal">
            <section class="session-modal panel" @onclick:stopPropagation="true">
                <div class="panel-header">
                    <h2>설정</h2>
                    <p>Codex CLI 실행 조건을 설정합니다.</p>
                </div>

                <div class="settings-tab-bar">
                    <button class="settings-tab @(SettingsTab == "session" ? "active" : "")" @onclick='() => SettingsTab = "session"'>Session</button>
                    <button class="settings-tab @(SettingsTab == "macros" ? "active" : "")" @onclick='() => SettingsTab = "macros"'>Macros</button>
                    <button class="settings-tab @(SettingsTab == "tools" ? "active" : "")" @onclick='() => SettingsTab = "tools"'>Tools</button>
                </div>

                @if (SettingsTab == "session")
                {
                    <label class="field">
                        <span>Workspace Path</span>
                        <input @bind="WorkspacePath" @bind:event="oninput" disabled="@ActiveTab.IsBusy" />
                    </label>

                    <label class="field">
                        <span>Codex Command</span>
                        <input @bind="CommandPath" @bind:event="oninput" disabled="@ActiveTab.IsBusy" />
                    </label>

                    <label class="field">
                        <span>Model</span>
                        <input @bind="Model" @bind:event="oninput" placeholder="비워두면 Codex 기본값 사용" disabled="@ActiveTab.IsBusy" />
                    </label>

                    <label class="toggle">
                        <input type="checkbox" @bind="AllowWorkspaceWrite" disabled="@ActiveTab.IsBusy" />
                        <span><code>--full-auto</code>로 workspace-write 허용</span>
                    </label>
                }

                @if (SettingsTab == "macros")
                {
                    <div class="status-row">
                        <span>Keydown Debug</span>
                        <strong>@MacroKeyDebug</strong>
                    </div>

                    <label class="field">
                        <span>Macro Name</span>
                        <input @bind="NewCodexMacroName" @bind:event="oninput" placeholder="예: 버그 분석 요청" disabled="@ActiveTab.IsBusy" />
                    </label>

                    <label class="field">
                        <span>Macro Text</span>
                        <textarea @bind="NewCodexMacroText" @bind:event="oninput" placeholder="Codex Prompt에 넣을 문구를 입력하세요." disabled="@ActiveTab.IsBusy"></textarea>
                    </label>

                    <label class="toggle">
                        <input type="checkbox" @bind="NewCodexMacroAutoSend" disabled="@ActiveTab.IsBusy" />
                        <span>실행 시 바로 전송</span>
                    </label>

                    <div class="button-row">
                        <button type="button" class="ghost" @onclick="AddCodexPromptMacroAsync" disabled="@ActiveTab.IsBusy">Add Macro</button>
                    </div>

                    @if (CodexPromptMacros.Count > 0)
                    {
                        <div class="macro-list @((DraggingMacroIndex.HasValue || IsPointerMacroDragActive) ? "drag-active" : string.Empty)"
                             tabindex="0"
                             @onkeydown="HandleMacroPanelKeyDown"
                             @onmouseup="EndPointerMacroDrag"
                             @onmouseleave="EndPointerMacroDrag">
                            @for (var i = 0; i < CodexPromptMacros.Count; i++)
                            {
                                var macroIndex = i;
                                var macro = CodexPromptMacros[i];
                                var isEditing = EditingMacroIndex == macroIndex;
                                var isDragging = DraggingMacroIndex == macroIndex;
                                var isDropTarget = DragOverMacroIndex == macroIndex && DraggingMacroIndex.HasValue && DraggingMacroIndex != macroIndex;
                                <article class="macro-item @(isDragging ? "dragging" : "") @(isDropTarget ? "drop-target" : "") @((DraggingMacroIndex.HasValue || IsPointerMacroDragActive) && !isDragging ? "drag-neighbor" : "")"
                                         draggable="@(!ActiveTab.IsBusy && !isEditing)"
                                         @ondragstart="(args) => BeginMacroDrag(macroIndex, args)"
                                         @ondragend="ClearMacroDragState"
                                         @ondragover:preventDefault
                                         @ondragover="(args) => SetMacroDragOver(macroIndex, args)"
                                         @ondrop:preventDefault
                                         @ondrop="() => CompleteMacroDropAsync(macroIndex)"
                                         @onmousedown="(args) => BeginPointerMacroDrag(macroIndex, args)"
                                         @onmouseenter="() => HoverPointerMacroDragAsync(macroIndex)"
                                         @onmouseup="EndPointerMacroDrag">
                                    <header>
                                        <strong>@macro.Name</strong>
                                        <span>
                                            @(macro.AutoSend ? "Type + Send" : "Type only")
                                            @if (!string.IsNullOrWhiteSpace(macro.Shortcut))
                                            {
                                                @($" · {macro.Shortcut}")
                                            }
                                        </span>
                                    </header>

                                    @if (isEditing)
                                    {
                                        <label class="field compact">
                                            <span>Macro Name</span>
                                            <input @bind="EditingCodexMacroName" @bind:event="oninput" disabled="@ActiveTab.IsBusy" />
                                        </label>
                                        <label class="field compact">
                                            <span>Macro Text</span>
                                            <textarea @bind="EditingCodexMacroText" @bind:event="oninput" disabled="@ActiveTab.IsBusy"></textarea>
                                        </label>
                                        <label class="toggle compact">
                                            <input type="checkbox" @bind="EditingCodexMacroAutoSend" disabled="@ActiveTab.IsBusy" />
                                            <span>실행 시 바로 전송</span>
                                        </label>
                                        <div class="button-row">
                                            <button type="button" class="primary" @onclick="SaveEditedCodexPromptMacroAsync" disabled="@ActiveTab.IsBusy">저장</button>
                                            <button type="button" class="ghost" @onclick="CancelEditCodexPromptMacro" disabled="@ActiveTab.IsBusy">취소</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <pre>@macro.Text</pre>
                                        <div class="button-row">
                                            <button type="button" class="primary" @onclick="() => ApplyCodexPromptMacroAsync(macro)" disabled="@ActiveTab.IsBusy">Run</button>
                                            <button type="button" class="ghost" @onclick="() => BeginEditCodexPromptMacro(macroIndex)" disabled="@ActiveTab.IsBusy">수정</button>
                                            <button type="button" class="ghost" @onclick="() => RemoveCodexPromptMacroAsync(macroIndex)" disabled="@ActiveTab.IsBusy">Delete</button>
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                }

                @if (SettingsTab == "tools")
                {
                    <div class="button-row">
                        <button type="button" class="ghost" @onclick="OpenCodexHelp">Open Codex Help</button>
                        <button type="button" class="primary" @onclick="OpenCodexCli">Open Codex CLI</button>
                        <button type="button" class="ghost" @onclick="OpenWorkspaceShell">Open Shell</button>
                    </div>

                    <p class="hint">
                        먼저 외부 콘솔 창에서 <code>codex</code>가 정상 실행되는지 확인한 뒤, 그 다음에 이 앱 내부 대화 경로를 보는 편이 안전합니다.
                    </p>
                }

                <div class="button-row">
                    <button type="button" class="ghost" @onclick="OpenCodexCli">Show CLI</button>
                    <button type="button" class="ghost" @onclick="StartFreshConversation" disabled="@ActiveTab.IsBusy">New Thread</button>
                    <button type="button" class="ghost" @onclick="CancelRun" disabled="@(!ActiveTab.IsBusy)">Cancel</button>
                    <button type="button" class="ghost" @onclick="CloseSessionModal">Close</button>
                </div>

                <p class="hint">
                    이 앱은 로컬에 <code>codex</code> CLI가 로그인되어 있고 네트워크에 접근 가능해야 정상 응답합니다.
                </p>
            </section>
        </div>
    }

    @if (ActiveTab.IsApprovalModalOpen && ActiveTab.PendingApprovalRequest is not null)
    {
        <div class="approval-modal-backdrop" @onclick="RejectApprovalAsync">
            <section class="approval-modal panel" @onclick:stopPropagation="true">
                <div class="panel-header">
                    <h2>Approval Required</h2>
                    <p>@ActiveTab.PendingApprovalRequest.Prompt</p>
                </div>

                <div class="button-row">
                    @foreach (var option in ActiveTab.PendingApprovalRequest.Options)
                    {
                        <button type="button" class="primary" @onclick="() => SelectApprovalOptionAsync(option.Value)">@option.Label</button>
                    }
                    <button type="button" class="ghost" @onclick="RejectApprovalAsync">Reject</button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private int _tabCounter;
    private List<ChatTab> _tabs = new();
    private string _activeTabId = string.Empty;

    private ChatTab ActiveTab => _tabs.FirstOrDefault(t => t.Id == _activeTabId) ?? _tabs[0];

    private string WorkspacePath { get; set; } = string.Empty;

    private string CommandPath { get; set; } = string.Empty;

    private string Model { get; set; } = string.Empty;

    private bool AllowWorkspaceWrite { get; set; } = true;

    private bool IsSessionModalOpen { get; set; }
    private string SettingsTab { get; set; } = "session";
    private bool IsHamburgerOpen { get; set; }
    private IList<CodexPromptMacroItem> CodexPromptMacros { get; set; } = new List<CodexPromptMacroItem>();
    private string NewCodexMacroName { get; set; } = string.Empty;
    private string NewCodexMacroText { get; set; } = string.Empty;
    private bool NewCodexMacroAutoSend { get; set; }
    private int? EditingMacroIndex { get; set; }
    private string EditingCodexMacroName { get; set; } = string.Empty;
    private string EditingCodexMacroText { get; set; } = string.Empty;
    private bool EditingCodexMacroAutoSend { get; set; }
    private int? DraggingMacroIndex { get; set; }
    private int? DragOverMacroIndex { get; set; }
    private bool IsPointerMacroDragActive { get; set; }
    private int? PointerMacroDragIndex { get; set; }
    private string MacroKeyDebug { get; set; } = "No key yet";
    private const int MacroShortcutDebounceMilliseconds = 350;
    private string _lastObservedShortcut = string.Empty;
    private DateTime _lastObservedShortcutAt = DateTime.MinValue;
    private bool IsMacrosSettingsVisible => IsSessionModalOpen && SettingsTab == "macros";
    private string StatusLabel =>
        ActiveTab.IsBusy
            ? BusyIndicatorText
            : string.IsNullOrWhiteSpace(ActiveTab.ThreadId)
                ? "Ready for a new conversation"
                : "Attached to an existing thread";

    private string BusyIndicatorText => $"답변 생성중{new string('.', _loadingDotCount)}";

    private System.Threading.Timer? _loadingIndicatorTimer;
    private int _loadingDotCount = 1;

    protected override void OnInitialized()
    {
        CommandPath = CodexCli.GetDefaultCommandPath();
        WorkspacePath = CodexCli.GetDefaultWorkspacePath();
        CodexPromptMacroService.KeyObserved += OnMacroKeyObserved;
        CodexPromptMacroService.PromptRequested += OnExternalPromptRequested;
        CodexPromptMacroService.Load();
        CodexPromptMacros = CodexPromptMacroService.Macros.ToList();
        AddNewTab();
    }

    private async Task SendAsync()
    {
        var tab = ActiveTab;
        if (tab.IsBusy || string.IsNullOrWhiteSpace(tab.DraftMessage))
        {
            return;
        }

        var prompt = tab.DraftMessage.Trim();
        tab.DraftMessage = string.Empty;
        tab.PendingPromptNotice = string.Empty;
        await InvokeAsync(StateHasChanged);
        await SendPromptAsync(prompt, addAsUserMessage: true, tab);
    }

    private async Task SendPromptAsync(string prompt, bool addAsUserMessage, ChatTab? targetTab = null)
    {
        var tab = targetTab ?? ActiveTab;
        if (tab.IsBusy || string.IsNullOrWhiteSpace(prompt))
        {
            return;
        }

        if (addAsUserMessage)
        {
            tab.Messages.Add(ChatMessage.User(prompt));
            UpdateTabTitle(tab);
        }

        tab.IsBusy = true;
        tab.BusyStartedAt = DateTimeOffset.Now;
        StartLoadingIndicator();
        tab.RunCts = new CancellationTokenSource();

        try
        {
            var result = await CodexCli.SendAsync(
                new CodexChatRequest(
                    prompt,
                    WorkspacePath.Trim(),
                    CommandPath.Trim(),
                    string.IsNullOrWhiteSpace(Model) ? null : Model.Trim(),
                    tab.ThreadId,
                    AllowWorkspaceWrite),
                tab.RunCts.Token);

            tab.ThreadId = result.ThreadId ?? tab.ThreadId;
            if (result.PendingApproval is not null)
            {
                tab.PendingApprovalRequest = result.PendingApproval;
                tab.IsApprovalModalOpen = true;

                if (!string.IsNullOrWhiteSpace(result.Message))
                {
                    tab.Messages.Add(ChatMessage.System($"Approval requested: {result.Message}"));
                }

                return;
            }

            tab.Messages.Add(result.Success ? ChatMessage.Assistant(result.Message) : ChatMessage.Error(result.Message));
        }
        finally
        {
            tab.IsBusy = false;
            tab.BusyStartedAt = null;
            StopLoadingIndicatorIfIdle();
            tab.RunCts?.Dispose();
            tab.RunCts = null;
        }
    }


    private async Task HandlePromptKeyDown(KeyboardEventArgs e)
    {
        if (await TryApplyMacroByShortcutAsync(e))
        {
            return;
        }

        if (e.Key == "Enter" && !e.AltKey && !e.CtrlKey && !e.ShiftKey && !e.MetaKey)
        {
            await SendAsync();
        }
    }

    private async Task HandleMacroPanelKeyDown(KeyboardEventArgs e)
    {
        var code = string.IsNullOrWhiteSpace(e.Code) ? "-" : e.Code;
        var key = string.IsNullOrWhiteSpace(e.Key) ? "-" : e.Key;
        MacroKeyDebug =
            $"{DateTime.Now:HH:mm:ss} key={key}, code={code}, ctrl={e.CtrlKey}, shift={e.ShiftKey}, alt={e.AltKey}, meta={e.MetaKey}";

        await TryApplyMacroByShortcutAsync(e);
    }

    private async Task<bool> TryApplyMacroByShortcutAsync(KeyboardEventArgs e)
    {
        if (e.Repeat)
        {
            return false;
        }

        if (!e.AltKey || e.CtrlKey || e.MetaKey)
        {
            return false;
        }

        var shortcut = BuildShortcutFromKeyEvent(e);
        if (string.IsNullOrWhiteSpace(shortcut))
        {
            return false;
        }

        var matchedMacro = CodexPromptMacros.FirstOrDefault(m =>
            string.Equals(m.Shortcut, shortcut, StringComparison.OrdinalIgnoreCase));

        if (matchedMacro is null)
        {
            return false;
        }

        if (IsDuplicatedMacroShortcutTrigger(shortcut))
        {
            return true;
        }

        await ApplyCodexPromptMacroAsync(matchedMacro);
        return true;
    }

    private async void OnMacroKeyObserved(string keyDebugMessage)
    {
        if (string.IsNullOrWhiteSpace(keyDebugMessage))
        {
            return;
        }

        var normalizedMessage = keyDebugMessage.Trim();
        var shouldRefreshDebugPanel = IsMacrosSettingsVisible;
        if (!shouldRefreshDebugPanel &&
            !TryExtractShortcutFromDebugMessage(normalizedMessage, out _))
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            if (shouldRefreshDebugPanel)
            {
                MacroKeyDebug = normalizedMessage;
            }

            var macroApplied = await TryApplyMacroByObservedMessageAsync(normalizedMessage);
            if (shouldRefreshDebugPanel || macroApplied)
            {
                StateHasChanged();
            }
        });
    }

    private async void OnExternalPromptRequested(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt))
        {
            return;
        }

        await InvokeAsync(() =>
        {
            if (_tabs.Count == 0 || ActiveTab.IsBusy)
            {
                AddNewTab();
            }

            var trimmedPrompt = prompt.Trim();
            ActiveTab.DraftMessage = trimmedPrompt;
            ActiveTab.PendingPromptNotice = BuildExternalPromptNotice(trimmedPrompt);
            UpdateTabTitle(ActiveTab);
            StateHasChanged();
        });
    }

    private static string BuildExternalPromptNotice(string prompt)
    {
        var lines = prompt
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries)
            .Select(line => line.Trim())
            .Where(line => line.StartsWith("Snapshot folder:", StringComparison.OrdinalIgnoreCase) ||
                           line.StartsWith("Snapshot path:", StringComparison.OrdinalIgnoreCase))
            .Take(2)
            .ToArray();

        if (lines.Length > 0)
        {
            return string.Join(Environment.NewLine, lines);
        }

        var preview = prompt.Length > 500 ? prompt[..500] + "..." : prompt;
        return preview;
    }

    private async Task<bool> TryApplyMacroByObservedMessageAsync(string keyDebugMessage)
    {
        if (!keyDebugMessage.Contains("webview key=", StringComparison.OrdinalIgnoreCase) &&
            !keyDebugMessage.Contains("webviewFocused=True", StringComparison.OrdinalIgnoreCase))
        {
            // WebView 포커스가 아닐 때 들어온 전역 훅(vk=...) 이벤트는 매크로 실행 트리거로 사용하지 않습니다.
            return false;
        }

        if (!TryExtractShortcutFromDebugMessage(keyDebugMessage, out var shortcut))
        {
            return false;
        }

        if (IsDuplicatedMacroShortcutTrigger(shortcut))
        {
            return false;
        }

        // Browser-side typing automation was removed with the Naver Talk workflow,
        // so WebView-focused shortcut messages are no longer executed here.
        return false;
    }

    private bool IsDuplicatedMacroShortcutTrigger(string shortcut)
    {
        if (string.IsNullOrWhiteSpace(shortcut))
        {
            return false;
        }

        var now = DateTime.UtcNow;
        if (string.Equals(_lastObservedShortcut, shortcut, StringComparison.OrdinalIgnoreCase)
            && (now - _lastObservedShortcutAt).TotalMilliseconds < MacroShortcutDebounceMilliseconds)
        {
            return true;
        }

        _lastObservedShortcut = shortcut;
        _lastObservedShortcutAt = now;
        return false;
    }

    private static bool TryExtractShortcutFromDebugMessage(string keyDebugMessage, out string shortcut)
    {
        shortcut = string.Empty;
        if (string.IsNullOrWhiteSpace(keyDebugMessage))
        {
            return false;
        }

        var normalized = keyDebugMessage.Trim();
        var lower = normalized.ToLowerInvariant();

        if (!lower.Contains("alt=true"))
        {
            return false;
        }

        if (lower.Contains("ctrl=true") || lower.Contains("meta=true") || lower.Contains("lwin=true") || lower.Contains("rwin=true"))
        {
            return false;
        }

        var codeToken = "code=";
        var codeIndex = lower.IndexOf(codeToken, StringComparison.Ordinal);
        if (codeIndex >= 0)
        {
            var codeStart = codeIndex + codeToken.Length;
            var codeEnd = normalized.IndexOf(',', codeStart);
            var code = (codeEnd >= 0 ? normalized[codeStart..codeEnd] : normalized[codeStart..]).Trim();
            if (code.StartsWith("Numpad", StringComparison.OrdinalIgnoreCase))
            {
                shortcut = $"Alt+{code}";
                return true;
            }
        }

        var vkToken = "vk=0x";
        var vkIndex = lower.IndexOf(vkToken, StringComparison.Ordinal);
        if (vkIndex < 0)
        {
            return false;
        }

        var openParen = normalized.IndexOf('(', vkIndex);
        var closeParen = openParen >= 0 ? normalized.IndexOf(')', openParen + 1) : -1;
        if (openParen < 0 || closeParen < 0 || closeParen <= openParen + 1)
        {
            return false;
        }

        if (!int.TryParse(normalized[(openParen + 1)..closeParen], out var vkCode))
        {
            return false;
        }

        int numpadNumber;
        if (vkCode is >= 97 and <= 105)
        {
            numpadNumber = vkCode - 96;
        }
        else if (vkCode is >= 49 and <= 57)
        {
            numpadNumber = vkCode - 48;
        }
        else
        {
            return false;
        }

        shortcut = $"Alt+Numpad{numpadNumber}";
        return true;
    }

    private static string BuildShortcutFromKeyEvent(KeyboardEventArgs e)
    {
        if (!string.IsNullOrWhiteSpace(e.Code) && e.Code.StartsWith("Numpad", StringComparison.OrdinalIgnoreCase))
        {
            return $"Alt+{e.Code}";
        }

        if (!string.IsNullOrWhiteSpace(e.Key) && e.Key.Length == 1 && char.IsDigit(e.Key[0]))
        {
            return $"Alt+Numpad{e.Key}";
        }

        return string.Empty;
    }

    private void OpenCodexCli()
    {
        var tab = ActiveTab;
        var error = CodexCli.LaunchInteractiveCli(
            WorkspacePath.Trim(),
            CommandPath.Trim(),
            string.IsNullOrWhiteSpace(Model) ? null : Model.Trim(),
            AllowWorkspaceWrite);

        if (string.IsNullOrWhiteSpace(error))
        {
            tab.Messages.Add(ChatMessage.System("Opened an external Codex CLI window."));
            return;
        }

        tab.Messages.Add(ChatMessage.Error(error));
    }

    private void ShowCurrentCodexCmd()
    {
        // Freeze the active tab at click time so resume target and preview stay in sync.
        var activeTabId = _activeTabId;
        var tab = _tabs.FirstOrDefault(t => t.Id == activeTabId) ?? ActiveTab;
        var preview = BuildConversationPreview(tab);

        var error = CodexCli.LaunchResumeWindow(
            WorkspacePath.Trim(),
            CommandPath.Trim(),
            string.IsNullOrWhiteSpace(Model) ? null : Model.Trim(),
            AllowWorkspaceWrite,
            tab.ThreadId,
            preview);

        if (string.IsNullOrWhiteSpace(error))
        {
            var message = string.IsNullOrWhiteSpace(tab.ThreadId)
                ? "Opened a visible Codex CLI window."
                : $"Opened a visible Codex resume window for thread {tab.ThreadId}.";
            tab.Messages.Add(ChatMessage.System(message));
            return;
        }

        tab.Messages.Add(ChatMessage.Error(error));
    }

    private static string BuildConversationPreview(ChatTab tab)
    {
        var messages = tab.Messages;
        if (messages.Count == 0)
        {
            return "No conversation yet.";
        }

        var previewMessages = messages.TakeLast(80);
        var lines = new List<string>();

        foreach (var message in previewMessages)
        {
            var role = message.RoleLabel;
            lines.Add($"[{message.Timestamp:yyyy-MM-dd HH:mm:ss}] {role}");
            lines.Add(message.Content);
            lines.Add(string.Empty);
        }

        return string.Join(Environment.NewLine, lines);
    }


<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:InterceptKit.App.Components"
             x:Class="InterceptKit.App.MainPage">

    <Grid ColumnDefinitions="1.35*,1.65*" RowDefinitions="Auto,*">
        <Border Grid.Column="0"
                Grid.RowSpan="2"
                Margin="12"
                Padding="0"
                StrokeThickness="1"
                Stroke="#1A000000"
                BackgroundColor="#F8FBFC"
                StrokeShape="RoundRectangle 18">
            <Grid RowDefinitions="Auto,Auto,*">
                <VerticalStackLayout Padding="16,16,16,8" Spacing="8">
                    <Label Text="Native WebView2 Browser"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#173844" />
                    <Label Text="Use the address box or refresh to generate paused requests."
                           FontSize="12"
                           TextColor="#5A737D" />
                    <Label x:Name="RuntimeStatusLabel"
                           FontSize="12"
                           TextColor="#173844" />
                    <Label x:Name="RuntimeDetailLabel"
                           FontSize="11"
                           TextColor="#5A737D" />
                </VerticalStackLayout>

                <Grid Grid.Row="1"
                      Margin="16,0,16,12"
                      ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="8">
                    <Entry x:Name="BrowserAddressEntry"
                           Placeholder="https://example.com"
                           Text="https://example.com" />
                    <Button Grid.Column="1"
                            Clicked="OnNavigateClicked"
                            Text="Go" />
                    <Button Grid.Column="2"
                            Clicked="OnRefreshClicked"
                            Text="Refresh" />
                </Grid>

                <WebView x:Name="BrowserWebView"
                         Grid.Row="2"
                         Margin="16,0,16,16"
                         HandlerChanged="OnBrowserWebViewHandlerChanged" />
            </Grid>
        </Border>

        <BlazorWebView Grid.Column="1"
                       Grid.RowSpan="2"
                       x:Name="BlazorHost"
                       HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>

</ContentPage>
